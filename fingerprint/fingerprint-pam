#!/bin/bash
#
# fingerprint-pam - turn fingerprint (pam_fprintd) authentication on or off
# for the login screen (sddm), polkit (administrator prompts) and sudo.
#
# Usage: fingerprint-pam enable|disable|status
#
# "enable" adds one line at the top of the auth stack of each PAM service:
#
#     auth       sufficient  pam_fprintd.so timeout=10  # lingmo-fingerprint
#
# and creates /etc/lingmo-fingerprint-enabled, which the lock screen and the
# login screen read to show the fingerprint hint. "disable" removes exactly the
# lines carrying the "# lingmo-fingerprint" tag and nothing else, then removes
# the marker. Both are idempotent. Before a file is changed a copy is kept in
# /var/lib/lingmo-settings/fingerprint-pam/backup (<service>.orig is the copy
# taken the first time, <service>.last the one taken before the latest change).
#
# A service that only exists in /usr/lib/pam.d (polkit-1 on Arch) is copied to
# /etc/pam.d first, since that copy wins; "disable" deletes the copy again when
# nothing else was changed in it.
#
# The lock screen (lingmo-screenlocker) is not edited here: it runs its own
# "lingmo-screenlocker-fingerprint" service next to the password one, so the
# password never waits for the reader.
#
# "status" works without root and prints "key: value" lines, the last one being
# "state: enabled|disabled|partial".
#
# Tests: LINGMO_FINGERPRINT_ROOT=<dir> makes the script use <dir>/etc/pam.d,
# <dir>/usr/lib/pam.d, <dir>/usr/lib/security, ... instead of the real system.
# It is refused when running as root.

set -u
umask 022
export LC_ALL=C
PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin

readonly TAG='# lingmo-fingerprint'
readonly PAM_LINE="auth       sufficient  pam_fprintd.so timeout=10  $TAG"
readonly SERVICES=(sddm polkit-1 sudo)
readonly PROG=${0##*/}

die() {
    echo "$PROG: $*" >&2
    exit 2
}

warn() {
    echo "$PROG: $*" >&2
}

ROOT=""
if [ -n "${LINGMO_FINGERPRINT_ROOT:-}" ]; then
    [ "$(id -u)" -eq 0 ] && die "LINGMO_FINGERPRINT_ROOT is only for tests and is refused as root"
    ROOT=${LINGMO_FINGERPRINT_ROOT%/}
    [ -d "$ROOT" ] || die "$ROOT is not a directory"
fi

readonly PAM_DIR="$ROOT/etc/pam.d"
readonly VENDOR_DIR="$ROOT/usr/lib/pam.d"
readonly MARKER="$ROOT/etc/lingmo-fingerprint-enabled"
readonly STATE_DIR="$ROOT/var/lib/lingmo-settings/fingerprint-pam"
readonly BACKUP_DIR="$STATE_DIR/backup"
readonly MODULE_DIRS=(
    "$ROOT/usr/lib/security"
    "$ROOT/usr/lib64/security"
    "$ROOT/lib/security"
    "$ROOT/usr/lib/x86_64-linux-gnu/security"
    "$ROOT/lib/x86_64-linux-gnu/security"
)

TMP_FILES=()
cleanup() {
    local f
    for f in "${TMP_FILES[@]}"; do
        [ -n "$f" ] && rm -f -- "$f"
    done
}
trap cleanup EXIT

have_module() {
    local d
    for d in "${MODULE_DIRS[@]}"; do
        [ -f "$d/pam_fprintd.so" ] && return 0
    done
    return 1
}

# Lines we own: a "# lingmo-fingerprint" comment, at the end of a line or as
# a line of its own (optionally followed by ":" and text).
readonly TAG_RE='#[[:space:]]*lingmo-fingerprint([[:space:]:]|$)'

has_tag() {
    grep -Eq -- "$TAG_RE" "$1"
}

# A pam_fprintd auth line that someone else added (not tagged by us).
has_foreign_fprintd() {
    grep -v -E -- "$TAG_RE" "$1" |
        grep -Eiq '^[[:space:]]*-?auth[[:space:]].*pam_fprintd\.so'
}

has_auth_line() {
    grep -Eiq '^[[:space:]]*-?auth[[:space:]]' "$1"
}

strip_tagged() {
    grep -v -E -- "$TAG_RE" "$1"
    return 0
}

# Print $1 with PAM_LINE inserted before the first auth line.
insert_line() {
    awk -v line="$PAM_LINE" '
        !done && tolower($0) ~ /^[ \t]*-?auth[ \t]/ { print line; done = 1 }
        { print }
        END { if (!done) exit 3 }
    ' "$1"
}

# Check that $1 is a PAM file we are willing to touch.
check_file() {
    local f=$1
    if [ -L "$f" ]; then
        warn "$f is a symbolic link, leaving it alone"
        return 1
    fi
    if [ ! -f "$f" ]; then
        warn "$f is not a regular file"
        return 1
    fi
    if [ ! -r "$f" ]; then
        warn "$f can't be read"
        return 1
    fi
    if [ "$(stat -c %s -- "$f")" -gt 65536 ]; then
        warn "$f is unexpectedly large, leaving it alone"
        return 1
    fi
    return 0
}

backup() {
    local svc=$1 f=$2
    mkdir -p -- "$BACKUP_DIR" || return 1
    chmod 700 -- "$STATE_DIR" "$BACKUP_DIR" 2>/dev/null
    if [ ! -e "$BACKUP_DIR/$svc.orig" ]; then
        cp -p -- "$f" "$BACKUP_DIR/$svc.orig" || return 1
    fi
    cp -p -- "$f" "$BACKUP_DIR/$svc.last" || return 1
}

# Atomically replace $1 with the content of $2, keeping owner and mode of
# $3 (the file being replaced, or the vendor file it is copied from).
replace_file() {
    local target=$1 content=$2 ref=$3 tmp
    tmp=$(mktemp -- "$PAM_DIR/.${target##*/}.lingmo.XXXXXX") || return 1
    TMP_FILES+=("$tmp")
    cat -- "$content" >"$tmp" || return 1
    chmod --reference="$ref" -- "$tmp" 2>/dev/null || chmod 644 -- "$tmp"
    chown --reference="$ref" -- "$tmp" 2>/dev/null
    sync -- "$tmp" 2>/dev/null
    mv -f -- "$tmp" "$target" || return 1
}

new_tmp() {
    local t
    t=$(mktemp) || die "can't create a temporary file"
    TMP_FILES+=("$t")
    echo "$t"
}

service_state() {
    local svc=$1 f="$PAM_DIR/$1" src
    if [ -e "$f" ] || [ -L "$f" ]; then
        src=$f
    elif [ -f "$VENDOR_DIR/$svc" ]; then
        src="$VENDOR_DIR/$svc"
    else
        echo missing
        return
    fi
    if [ "$src" = "$f" ] && has_tag "$f"; then
        echo enabled
    elif has_foreign_fprintd "$src"; then
        echo external
    else
        echo disabled
    fi
}

enable_service() {
    local svc=$1 f="$PAM_DIR/$1" vendor="$VENDOR_DIR/$1" src ref copied=0 out orig

    if [ -e "$f" ] || [ -L "$f" ]; then
        check_file "$f" || return 1
        src=$f
        ref=$f
    elif [ -f "$vendor" ]; then
        check_file "$vendor" || return 1
        src=$vendor
        ref=$vendor
        copied=1
    else
        echo "$svc: missing (not installed), skipped"
        return 0
    fi

    if [ $copied -eq 0 ] && has_tag "$f"; then
        echo "$svc: already enabled"
        return 0
    fi
    if has_foreign_fprintd "$src"; then
        echo "$svc: pam_fprintd already configured by the administrator, left alone"
        return 0
    fi
    if ! has_auth_line "$src"; then
        warn "$src has no auth line, leaving it alone"
        return 1
    fi

    out=$(new_tmp)
    if ! insert_line "$src" >"$out"; then
        warn "couldn't add the fingerprint line to $src"
        return 1
    fi
    if [ $copied -eq 1 ]; then
        echo "$TAG: copy of ${vendor#"$ROOT"}, deleted again by \"$PROG disable\"" >>"$out"
    fi

    # Sanity check: the new file is the old one plus our tagged lines.
    orig=$(new_tmp)
    strip_tagged "$out" >"$orig"
    if ! strip_tagged "$src" | cmp -s - "$orig"; then
        warn "unexpected result for $svc, nothing changed"
        return 1
    fi

    if [ $copied -eq 0 ]; then
        backup "$svc" "$f" || { warn "couldn't back up $f, nothing changed"; return 1; }
    fi
    replace_file "$f" "$out" "$ref" || { warn "couldn't write $f"; return 1; }
    echo "$svc: enabled"
}

disable_service() {
    local svc=$1 f="$PAM_DIR/$1" vendor="$VENDOR_DIR/$1" out copied=0

    if [ ! -e "$f" ] && [ ! -L "$f" ]; then
        echo "$svc: nothing to do"
        return 0
    fi
    check_file "$f" || return 1
    if ! has_tag "$f"; then
        echo "$svc: already disabled"
        return 0
    fi
    grep -Eq -- "^$TAG:" "$f" && copied=1

    out=$(new_tmp)
    strip_tagged "$f" >"$out"

    backup "$svc" "$f" || { warn "couldn't back up $f, nothing changed"; return 1; }

    if [ $copied -eq 1 ] && [ -f "$vendor" ] && cmp -s -- "$out" "$vendor"; then
        # Our own copy of the vendor file and nothing else changed in it.
        rm -f -- "$f" || { warn "couldn't remove $f"; return 1; }
        echo "$svc: disabled (removed the copy of ${vendor#"$ROOT"})"
        return 0
    fi
    if [ ! -s "$out" ] || ! has_auth_line "$out"; then
        warn "$f would be left without an auth line, nothing changed"
        return 1
    fi
    replace_file "$f" "$out" "$f" || { warn "couldn't write $f"; return 1; }
    echo "$svc: disabled"
}

write_marker() {
    local out
    mkdir -p -- "${MARKER%/*}" || return 1
    out=$(new_tmp)
    {
        echo "# Written by $PROG: fingerprint authentication is enabled."
        echo "# Remove it with \"$PROG disable\"."
    } >"$out"
    install -m 644 -- "$out" "$MARKER"
}

lock() {
    mkdir -p -- "$STATE_DIR" || die "can't create $STATE_DIR"
    chmod 700 -- "$STATE_DIR" 2>/dev/null
    exec 9>"$STATE_DIR/lock" || die "can't open the lock file"
    flock -w 30 9 || die "another instance is running"
}

need_root() {
    if [ -z "$ROOT" ] && [ "$(id -u)" -ne 0 ]; then
        die "must be run as root (pkexec $0 $1)"
    fi
}

cmd_status() {
    local svc st enabled=0 disabled=0 marker=absent
    if have_module; then
        echo "module: present"
    else
        echo "module: missing"
    fi
    for svc in "${SERVICES[@]}"; do
        st=$(service_state "$svc")
        echo "$svc: $st"
        case $st in
            enabled|external) enabled=$((enabled + 1)) ;;
            disabled) disabled=$((disabled + 1)) ;;
        esac
    done
    [ -e "$MARKER" ] && marker=present
    echo "marker: $marker"
    if [ $marker = present ] && [ $disabled -eq 0 ] && [ $enabled -gt 0 ]; then
        echo "state: enabled"
    elif [ $marker = absent ] && [ $enabled -eq 0 ]; then
        echo "state: disabled"
    else
        echo "state: partial"
    fi
}

cmd_enable() {
    local svc failed=0 done_any=0 st
    need_root enable
    have_module || die "pam_fprintd.so not found: install the fprintd package first"
    [ -d "$PAM_DIR" ] || die "$PAM_DIR doesn't exist"
    lock
    for svc in "${SERVICES[@]}"; do
        if enable_service "$svc"; then
            st=$(service_state "$svc")
            [ "$st" = enabled ] || [ "$st" = external ] && done_any=1
        else
            failed=1
        fi
    done
    if [ $done_any -eq 1 ]; then
        write_marker || { warn "couldn't write $MARKER"; failed=1; }
    else
        warn "no PAM service could be set up"
        failed=1
    fi
    [ $failed -eq 0 ] || exit 2
}

cmd_disable() {
    local svc failed=0
    need_root disable
    [ -d "$PAM_DIR" ] || die "$PAM_DIR doesn't exist"
    lock
    for svc in "${SERVICES[@]}"; do
        disable_service "$svc" || failed=1
    done
    rm -f -- "$MARKER" || { warn "couldn't remove $MARKER"; failed=1; }
    [ $failed -eq 0 ] || exit 2
}

case "${1:-}" in
    enable) cmd_enable ;;
    disable) cmd_disable ;;
    status) cmd_status ;;
    *)
        echo "Usage: $PROG enable|disable|status" >&2
        exit 1
        ;;
esac
